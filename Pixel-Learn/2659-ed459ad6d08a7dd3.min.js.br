figma.viewport.slidesView = 'grid';
figma.currentPage.selection = nodes;`;function A(e){return e===n.FW.FIGMA?g:e===n.FW.FIGJAM?_:e===n.FW.SLIDES?f:e=>""}function y(e){let t="";return e===n.FW.FIGMA&&(t+="// Runs this code if the plugin is run in Figma\nif (figma.editorType === 'figma') {"),e===n.FW.FIGJAM&&(t+="// Runs this code if the plugin is run in FigJam\nif (figma.editorType === 'figjam') {"),e===n.FW.SLIDES&&(t+="// Runs this code if the plugin is run in Slides\nif (figma.editorType === 'slides') {"),t}let b=`// This shows the HTML page in "ui.html".
