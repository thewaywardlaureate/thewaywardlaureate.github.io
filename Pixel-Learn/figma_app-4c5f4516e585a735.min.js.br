 document.addEventListener('keydown', (e) => {
   if (e.keyCode === 80 /* P */ && !e.shiftKey && e.altKey && ${d.Ay.mac?"!e.ctrlKey && e.metaKey":"e.ctrlKey && !e.metaKey"}) {
